    <DTS:Executable
      DTS:refId="Package\SCT_Finalize"
      DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:DTSID="{A1B2C3D4-0001-0005-0005-000000000001}"
      DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCT_Finalize — Clôturer Run ETL">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[StagingDB]"
          SQLTask:SqlStatementSource="EXEC [log].usp_EndRun @RunID = ?, @Statut = N'SUCCES';">
          <SQLTask:ParameterBindings>
            <SQLTask:ParameterBinding
              SQLTask:DtsVariableName="User::RunID"
              SQLTask:ParameterDirection="Input"
              SQLTask:DataType="3"
              SQLTask:ParameterName="0"
              SQLTask:ParameterSize="-1" />
          </SQLTask:ParameterBindings>
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

