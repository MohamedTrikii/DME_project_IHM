            DTS:From="Package\SEQ_Dimensions\EPT_DimPatient"
            DTS:To="Package\SEQ_Dimensions\EPT_DimMedecin"
            DTS:DTSID="{A1B2C3D4-0001-0006-0001-000000000001}"
            DTS:EvalOp="1"
            DTS:LogicalAnd="True"
            DTS:ObjectName="PC_DimPatient_DimMedecin" />
          <DTS:PrecedenceConstraint
            DTS:refId="Package\SEQ_Dimensions.PrecedenceConstraints[PC_DimMedecin_DimOthers]"
            DTS:From="Package\SEQ_Dimensions\EPT_DimMedecin"
            DTS:To="Package\SEQ_Dimensions\EPT_DimOthers"
            DTS:DTSID="{A1B2C3D4-0001-0006-0002-000000000001}"
            DTS:EvalOp="1"
            DTS:LogicalAnd="True"
            DTS:ObjectName="PC_DimMedecin_DimOthers" />
        </DTS:PrecedenceConstraints>

      </DTS:Executables>
    </DTS:Executable>

    <!-- ─────────────────────────────────────────────────
