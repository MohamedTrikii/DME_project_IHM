            </ExecutePackageTask:ExecutePackageTaskData>
          </DTS:ObjectData>
        </DTS:Executable>

        <DTS:Executable
          DTS:refId="Package\SEQ_Dimensions\EPT_DimMedecin"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0005-0003-000000000003}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="EPT_DimMedecin — SCD2 Médecin">
          <DTS:ObjectData>
            <ExecutePackageTask:ExecutePackageTaskData
              xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
              ExecutePackageTask:PackageName="03_Load_Dim_Medecin.dtsx"
              ExecutePackageTask:UseProjectReference="True">
            </ExecutePackageTask:ExecutePackageTaskData>
          </DTS:ObjectData>
        </DTS:Executable>

        <DTS:Executable
          DTS:refId="Package\SEQ_Dimensions\EPT_DimOthers"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0005-0003-000000000004}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="EPT_DimOthers — Toutes autres dimensions">
          <DTS:ObjectData>
            <ExecutePackageTask:ExecutePackageTaskData
              xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
              ExecutePackageTask:PackageName="04_Load_Dimensions.dtsx"
              ExecutePackageTask:UseProjectReference="True">
            </ExecutePackageTask:ExecutePackageTaskData>
          </DTS:ObjectData>
        </DTS:Executable>

        <!-- Contraintes de précédence dans SEQ_Dimensions -->
        <DTS:PrecedenceConstraints>
          <DTS:PrecedenceConstraint
