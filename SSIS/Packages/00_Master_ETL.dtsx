<?xml version="1.0"?>
<!--
  ============================================================
  Package SSIS : 00_Master_ETL.dtsx
  Description  : Package orchestrateur principal du pipeline ETL DME
                 Équivalent du Master Package AdventureWorksDW ETL
  Rôle         : Appelle séquentiellement tous les sous-packages
                 Gère les logs de début/fin d'exécution globaux
                 Gère les erreurs et alertes au niveau pipeline
  Projet       : DME_BI - Architecture SSIS Professionnelle
  Cours        : 2 GLID 2025-2026
  ============================================================
  CONTROL FLOW :
  ┌─────────────────────────────────────────────────────┐
  │  SCT_Init : Initialize ETL Run                      │
  │     → SQL: log.usp_StartRun → @RunID                │
  ├─────────────────────────────────────────────────────┤
  │  SCT_ValidateConnections : Test connections         │
  ├─────────────────────────────────────────────────────┤
  │  EPT_Staging : Execute 01_Staging_Extract.dtsx      │
  ├─────────────────────────────────────────────────────┤
  │  SEQ_Dimensions : Sequence Container Dimensions     │
  │   ├── EPT_DimPatient : 02_Load_Dim_Patient.dtsx     │
  │   ├── EPT_DimMedecin : 03_Load_Dim_Medecin.dtsx     │
  │   └── EPT_DimOthers  : 04_Load_Dimensions.dtsx      │
  ├─────────────────────────────────────────────────────┤
  │  SEQ_Facts : Sequence Container Facts               │
  │   ├── EPT_Consultation: 05_Load_Fact_Consultation   │
  │   ├── EPT_Ordonnance  : 06_Load_Fact_Ordonnance     │
  │   ├── EPT_Analyse     : 06_Load_Fact_Analyse        │
  │   └── EPT_Hospi       : 06_Load_Fact_Hospi          │
  ├─────────────────────────────────────────────────────┤
  │  SCT_Finalize : End ETL Run, log stats              │
  └─────────────────────────────────────────────────────┘
  ERROR HANDLER : OnError → log.usp_LogError + email alert
-->
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="5/1/2026 2:00:00 AM"
  DTS:CreationName="MSPKG"
  DTS:CreatorComputerName="DME-BI-SERVER"
  DTS:CreatorName="DME_BI_Team"
  DTS:DTSID="{A1B2C3D4-0001-0001-0001-000000000001}"
  DTS:ExecutableType="MSPKG"
  DTS:LastModifiedProductVersion="15.0.2000.130"
  DTS:LocaleID="1036"
  DTS:ObjectName="00_Master_ETL"
  DTS:PackageType="5"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{A1B2C3D4-0001-0001-0001-000000000002}">

  <!-- =====================================================
       GESTIONNAIRES DE CONNEXIONS
       ===================================================== -->
  <DTS:ConnectionManagers>

    <!-- Connexion à DME_SourceDB (OLTP) -->
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[SourceDB]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{A1B2C3D4-0001-0002-0001-000000000001}"
      DTS:ObjectName="SourceDB">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=.;Initial Catalog=DME_SourceDB;Provider=SQLNCLI11.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>

    <!-- Connexion à DME_Staging -->
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[StagingDB]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{A1B2C3D4-0001-0002-0002-000000000001}"
      DTS:ObjectName="StagingDB">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=.;Initial Catalog=DME_Staging;Provider=SQLNCLI11.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>

    <!-- Connexion à DME_DataWarehouse -->
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[DWH]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{A1B2C3D4-0001-0002-0003-000000000001}"
      DTS:ObjectName="DWH">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=.;Initial Catalog=DME_DataWarehouse;Provider=SQLNCLI11.1;Integrated Security=SSPI;Auto Translate=False;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>

    <!-- Connexion pour les fichiers de log plat -->
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[LogFile]"
      DTS:CreationName="FILE"
      DTS:DTSID="{A1B2C3D4-0001-0002-0004-000000000001}"
      DTS:ObjectName="LogFile">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:FileUsageType="0"
          DTS:ConnectionString="C:\DME_BI\Logs\ETL_Master.log" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>

  </DTS:ConnectionManagers>

  <!-- =====================================================
       VARIABLES DU PACKAGE
       ===================================================== -->
  <DTS:Variables>

    <!-- Identifiant unique du run ETL (peuplé par usp_StartRun) -->
    <DTS:Variable
      DTS:DataType="3"
      DTS:DTSID="{A1B2C3D4-0001-0003-0001-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="RunID">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>

    <!-- Type d'exécution : FULL ou INCREMENTAL -->
    <DTS:Variable
      DTS:DataType="8"
      DTS:DTSID="{A1B2C3D4-0001-0003-0002-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TypeExecution">
      <DTS:VariableValue DTS:DataType="8">FULL</DTS:VariableValue>
    </DTS:Variable>

    <!-- Environnement : DEV / TEST / PROD -->
    <DTS:Variable
      DTS:DataType="8"
      DTS:DTSID="{A1B2C3D4-0001-0003-0003-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Environnement">
      <DTS:VariableValue DTS:DataType="8">PROD</DTS:VariableValue>
    </DTS:Variable>

    <!-- Nombre total d'erreurs (agrégé en fin de run) -->
    <DTS:Variable
      DTS:DataType="3"
      DTS:DTSID="{A1B2C3D4-0001-0003-0004-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="NombreErreurs">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>

    <!-- Message d'erreur pour le gestionnaire OnError -->
    <DTS:Variable
      DTS:DataType="8"
      DTS:DTSID="{A1B2C3D4-0001-0003-0005-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="MessageErreur">
      <DTS:VariableValue DTS:DataType="8"></DTS:VariableValue>
    </DTS:Variable>

    <!-- Chemin du fichier de configuration -->
    <DTS:Variable
      DTS:DataType="8"
      DTS:DTSID="{A1B2C3D4-0001-0003-0006-000000000001}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConfigPath">
      <DTS:VariableValue DTS:DataType="8">C:\DME_BI\Config\DME_ETL.dtsConfig</DTS:VariableValue>
    </DTS:Variable>

  </DTS:Variables>

  <!-- =====================================================
       CONFIGURATIONS (fichier .dtsConfig externe)
       ===================================================== -->
  <DTS:Configurations>
    <DTS:Configuration
      DTS:ConfigurationString="C:\DME_BI\Config\DME_ETL.dtsConfig"
      DTS:ConfigurationType="1"
      DTS:DTSID="{A1B2C3D4-0001-0004-0001-000000000001}"
      DTS:ObjectName="DME_ETL_Config" />
  </DTS:Configurations>

  <!-- =====================================================
       CONTROL FLOW — TÂCHES
       ===================================================== -->
  <DTS:Executables>

    <!-- ─────────────────────────────────────────────────
         TÂCHE 1 : Initialisation du Run ETL
         Appelle log.usp_StartRun et récupère le RunID
         ───────────────────────────────────────────────── -->
    <DTS:Executable
      DTS:refId="Package\SCT_Init"
      DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:DTSID="{A1B2C3D4-0001-0005-0001-000000000001}"
      DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCT_Init — Démarrer Run ETL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[StagingDB]"
          SQLTask:SqlStatementSource="DECLARE @RunID INT;
EXEC [log].usp_StartRun
    @TypeExecution    = ?,
    @NomEnvironnement = ?,
    @RunID            = @RunID OUTPUT;
SELECT @RunID AS RunID;"
          SQLTask:ResultSetType="1">
          <!-- Paramètres d'entrée -->
          <SQLTask:ParameterBindings>
            <SQLTask:ParameterBinding
              SQLTask:DtsVariableName="User::TypeExecution"
              SQLTask:ParameterDirection="Input"
              SQLTask:DataType="8"
              SQLTask:ParameterName="0"
              SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding
              SQLTask:DtsVariableName="User::Environnement"
              SQLTask:ParameterDirection="Input"
              SQLTask:DataType="8"
              SQLTask:ParameterName="1"
              SQLTask:ParameterSize="-1" />
          </SQLTask:ParameterBindings>
          <!-- Paramètre de sortie : RunID -->
          <SQLTask:ResultBindings>
            <SQLTask:ResultBinding
              SQLTask:DtsVariableName="User::RunID"
              SQLTask:ResultName="RunID" />
          </SQLTask:ResultBindings>
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ─────────────────────────────────────────────────
         TÂCHE 2 : Execute Package — Staging
         ───────────────────────────────────────────────── -->
    <DTS:Executable
      DTS:refId="Package\EPT_Staging"
      DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:DTSID="{A1B2C3D4-0001-0005-0002-000000000001}"
      DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT_Staging — Extraction OLTP vers Staging">
      <DTS:ObjectData>
        <ExecutePackageTask:ExecutePackageTaskData
          xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
          ExecutePackageTask:PackageName="01_Staging_Extract.dtsx"
          ExecutePackageTask:UseProjectReference="True">
        </ExecutePackageTask:ExecutePackageTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

    <!-- ─────────────────────────────────────────────────
         TÂCHE 3 : Séquence Dimensions
         ───────────────────────────────────────────────── -->
    <DTS:Executable
      DTS:refId="Package\SEQ_Dimensions"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:DTSID="{A1B2C3D4-0001-0005-0003-000000000001}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="SEQ_Dimensions — Chargement toutes dimensions">
      <DTS:Executables>

        <DTS:Executable
          DTS:refId="Package\SEQ_Dimensions\EPT_DimPatient"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0005-0003-000000000002}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="EPT_DimPatient — SCD2 Patient">
          <DTS:ObjectData>
            <ExecutePackageTask:ExecutePackageTaskData
              xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
              ExecutePackageTask:PackageName="02_Load_Dim_Patient.dtsx"
