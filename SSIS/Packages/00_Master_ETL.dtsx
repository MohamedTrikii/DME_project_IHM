      DTS:CreationName="STOCK:SEQUENCE"
      DTS:DTSID="{A1B2C3D4-0001-0005-0004-000000000001}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="SEQ_Facts — Chargement tables de faits">
      <DTS:Executables>

        <DTS:Executable
          DTS:refId="Package\SEQ_Facts\EPT_FactConsultation"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0005-0004-000000000002}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="EPT_FactConsultation">
          <DTS:ObjectData>
            <ExecutePackageTask:ExecutePackageTaskData
              xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
              ExecutePackageTask:PackageName="05_Load_Fact_Consultation.dtsx"
              ExecutePackageTask:UseProjectReference="True">
            </ExecutePackageTask:ExecutePackageTaskData>
          </DTS:ObjectData>
        </DTS:Executable>

        <DTS:Executable
          DTS:refId="Package\SEQ_Facts\EPT_FactsRest"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0005-0004-000000000003}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecutePackageTask.ExecutePackageTask, Microsoft.SqlServer.ExecPkgTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="EPT_FactsRest — Ordonnance, Analyse, Hospitalisation">
          <DTS:ObjectData>
            <ExecutePackageTask:ExecutePackageTaskData
              xmlns:ExecutePackageTask="www.microsoft.com/SqlServer/Dts/Tasks/ExecutePackageTask"
              ExecutePackageTask:PackageName="06_Load_Facts_Rest.dtsx"
              ExecutePackageTask:UseProjectReference="True">
            </ExecutePackageTask:ExecutePackageTaskData>
          </DTS:ObjectData>
        </DTS:Executable>

        <DTS:PrecedenceConstraints>
          <DTS:PrecedenceConstraint
            DTS:refId="Package\SEQ_Facts.PrecedenceConstraints[PC_FactConsult_FactsRest]"
            DTS:From="Package\SEQ_Facts\EPT_FactConsultation"
            DTS:To="Package\SEQ_Facts\EPT_FactsRest"
            DTS:DTSID="{A1B2C3D4-0001-0006-0003-000000000001}"
            DTS:EvalOp="1"
            DTS:LogicalAnd="True"
            DTS:ObjectName="PC_FactConsult_FactsRest" />
        </DTS:PrecedenceConstraints>

      </DTS:Executables>
    </DTS:Executable>

    <!-- ─────────────────────────────────────────────────
