  <!-- =====================================================
       CONTRAINTES DE PRÉCÉDENCE (Control Flow principal)
       ===================================================== -->
  <DTS:PrecedenceConstraints>

    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[PC_Init_Staging]"
      DTS:From="Package\SCT_Init"
      DTS:To="Package\EPT_Staging"
      DTS:DTSID="{A1B2C3D4-0001-0006-0010-000000000001}"
      DTS:EvalOp="1"
      DTS:LogicalAnd="True"
      DTS:ObjectName="PC_Init_Staging" />

    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[PC_Staging_Dimensions]"
      DTS:From="Package\EPT_Staging"
      DTS:To="Package\SEQ_Dimensions"
      DTS:DTSID="{A1B2C3D4-0001-0006-0010-000000000002}"
      DTS:EvalOp="1"
      DTS:LogicalAnd="True"
      DTS:ObjectName="PC_Staging_Dimensions" />

    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[PC_Dimensions_Facts]"
      DTS:From="Package\SEQ_Dimensions"
      DTS:To="Package\SEQ_Facts"
      DTS:DTSID="{A1B2C3D4-0001-0006-0010-000000000003}"
      DTS:EvalOp="1"
      DTS:LogicalAnd="True"
      DTS:ObjectName="PC_Dimensions_Facts" />

    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[PC_Facts_Finalize]"
      DTS:From="Package\SEQ_Facts"
      DTS:To="Package\SCT_Finalize"
      DTS:DTSID="{A1B2C3D4-0001-0006-0010-000000000004}"
      DTS:EvalOp="1"
      DTS:LogicalAnd="True"
      DTS:ObjectName="PC_Facts_Finalize" />

  </DTS:PrecedenceConstraints>

  <!-- =====================================================
       GESTIONNAIRE D'ÉVÉNEMENTS — OnError (global)
       ===================================================== -->
  <DTS:EventHandlers>
    <DTS:EventHandler
      DTS:refId="Package.EventHandlers[OnError]"
      DTS:CreationName=""
      DTS:DTSID="{A1B2C3D4-0001-0007-0001-000000000001}"
      DTS:EventName="OnError"
      DTS:ObjectName="OnError">
      <DTS:Variables>
        <DTS:Variable
          DTS:DataType="8"
          DTS:DTSID="{A1B2C3D4-0001-0007-0002-000000000001}"
          DTS:Namespace="System"
          DTS:ObjectName="ErrorDescription">
          <DTS:VariableValue DTS:DataType="8"></DTS:VariableValue>
        </DTS:Variable>
      </DTS:Variables>
      <DTS:Executables>
        <!-- Enregistrer l'erreur dans log.ETL_ErrorLog -->
        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\SCT_LogError"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:DTSID="{A1B2C3D4-0001-0007-0003-000000000001}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:ObjectName="SCT_LogError — Enregistrer erreur">
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
              SQLTask:Connection="Package.ConnectionManagers[StagingDB]"
              SQLTask:SqlStatementSource="EXEC [log].usp_LogError
    @RunID          = ?,
    @NomPackage     = N'00_Master_ETL',
    @MessageErreur  = ?,
    @Severite       = N'CRITIQUE';">
              <SQLTask:ParameterBindings>
                <SQLTask:ParameterBinding
                  SQLTask:DtsVariableName="User::RunID"
                  SQLTask:ParameterDirection="Input"
                  SQLTask:DataType="3"
                  SQLTask:ParameterName="0"
                  SQLTask:ParameterSize="-1" />
                <SQLTask:ParameterBinding
                  SQLTask:DtsVariableName="System::ErrorDescription"
