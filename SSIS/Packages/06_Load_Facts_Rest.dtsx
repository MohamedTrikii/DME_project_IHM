      DTS:From="Package\SCT_LoadFactAnalyse"
      DTS:To="Package\SCT_LoadFactHospi"
      DTS:DTSID="{A1B2C3D4-0007-0006-0002-000000000001}"
      DTS:EvalOp="1" DTS:LogicalAnd="True" DTS:ObjectName="PC_Analyse_Hospi" />
  </DTS:PrecedenceConstraints>

</DTS:Executable>
