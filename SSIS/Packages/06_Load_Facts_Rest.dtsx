      DTS:DTSID="{A1B2C3D4-0007-0006-0001-000000000001}"
      DTS:EvalOp="1" DTS:LogicalAnd="True" DTS:ObjectName="PC_Ordo_Analyse" />
    <DTS:PrecedenceConstraint
