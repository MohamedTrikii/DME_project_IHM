<?xml version="1.0"?>
<!--
  ============================================================
  Package SSIS : 06_Load_Facts_Rest.dtsx
  Description  : Chargement des 3 tables de faits restantes :
                 Fact_Ordonnance, Fact_Analyse, Fact_Hospitalisation
  Stratégie    : Execute SQL Tasks (MERGE T-SQL pour chaque fait)
                 Séquence : Ordonnance → Analyse → Hospitalisation
  Projet       : DME_BI - Architecture SSIS Professionnelle
  ============================================================
-->
